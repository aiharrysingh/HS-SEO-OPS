# Copy to .env.local and fill in. Every value here is optional for local dev —
# with none of them set the app runs on embedded Postgres with seed data.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset -> embedded Postgres in ./.pglite (no account needed, real Postgres SQL).
# Set   -> any Postgres. Neon, Supabase, or your own.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Google Search Console
# ---------------------------------------------------------------------------
# Create a service account, enable the Search Console API, then add the service
# account's email as a user on each property in Search Console (read access is
# enough). Without these, the app runs on stored data and the sync button
# reports that it isn't configured.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=hs-seo-ops@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# Required before /api/cron/nightly will run at all — it refuses without one.
# Call it as: Authorization: Bearer $CRON_SECRET
# CRON_SECRET=generate-a-long-random-string
